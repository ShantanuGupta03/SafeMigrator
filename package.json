{
  "name": "safe-migrator",
  "version": "0.1.0",
  "private": true,
  "description": "Guided, noncustodial migration from an EOA to a 2-of-3 Safe across EVM networks.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:network": "RUN_NETWORK_TESTS=1 vitest run tests/integration/safe-prediction.test.ts",
    "test:fork": "bash scripts/fork-test.sh",
    "test:local": "bash scripts/local-chain.sh env RUN_FORK_TESTS=1 RUN_LOCAL_TESTS=1 npx vitest run tests/integration",
    "test:e2e:local": "bash scripts/local-chain.sh env RPC_RATE_LIMIT_PER_MINUTE=5000 npx playwright test --project=desktop",
    "compile:contracts": "node scripts/compile-test-contracts.mjs"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@safe-global/protocol-kit": "^8.0.10",
    "@safe-global/safe-deployments": "^1.37.65",
    "@tanstack/react-query": "^5.104.5",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.57.11",
    "wagmi": "^3.7.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "solc": "^0.8.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.15",
    "@rolldown/binding-linux-x64-gnu": "1.2.15"
  }
}
