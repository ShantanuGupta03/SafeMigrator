# ---------------------------------------------------------------------------
# Safe Migrator configuration. Copy to .env.local and adjust.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and never shipped
# to the browser. Put every credential (RPC keys, indexer keys) there.
# ---------------------------------------------------------------------------

# --- Server-side RPC endpoints (optional; public RPCs are used when unset) ---
# Used by the read-only /api/rpc/[chainId] proxy. Keys stay on the server.
RPC_URL_11155111=          # Sepolia, e.g. https://eth-sepolia.g.alchemy.com/v2/<key>
RPC_URL_10200=             # Gnosis Chiado
RPC_URL_84532=             # Base Sepolia
RPC_URL_1=                 # Ethereum
RPC_URL_8453=              # Base
RPC_URL_42161=             # Arbitrum One
RPC_URL_10=                # OP Mainnet
RPC_URL_137=               # Polygon PoS

# --- Asset indexer (server-side) ---
# blockscout (default, no key required) | alchemy | none
ASSET_INDEXER=blockscout
ALCHEMY_API_KEY=

# --- Wallet connectivity (public by design) ---
# WalletConnect Cloud project ID. Enables WalletConnect (mobile + hardware via apps).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Execution gating ---
# Production-network execution is OFF by default. Discovery always works.
# Enabling requires BOTH flags below, and at runtime the app additionally
# requires >= threshold owners verified by wallet signature.
NEXT_PUBLIC_ENABLE_MAINNET_EXECUTION=false
# Comma-separated chain IDs allowed to execute when the flag above is true, e.g. 8453,10
NEXT_PUBLIC_MAINNET_EXECUTION_CHAINS=

# --- Safety margins (basis points; 10000 = 1.0x) ---
NEXT_PUBLIC_GAS_LIMIT_MARGIN_BPS=13000
NEXT_PUBLIC_FEE_MARGIN_BPS=12500
# Skip native transfers whose value is below this multiple of their own fee.
NEXT_PUBLIC_DUST_FEE_MULTIPLE=3

# --- RPC proxy rate limit (server-only) ---
# Requests per minute per client IP and chain on /api/rpc/[chainId]. Default 120.
RPC_RATE_LIMIT_PER_MINUTE=
